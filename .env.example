# Browser configuration: public Supabase URL and publishable/anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server configuration: must refer to the SAME project as the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Optional when the protected gwcc-staff Edge Function is deployed;
# Supabase then supplies this credential within its own server runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS origin. Add /auth/password to Supabase's allowed redirect URLs.
APP_ORIGIN=
# Optional additional trusted origins, comma separated. Same-host requests are accepted.
ALLOWED_ORIGINS=

# Optional AI provider. Without a key the assistant returns an honest unavailable response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
